<REAPER_PROJECT 0.1 "7.86/macOS-arm64" 0
  SAMPLERATE @RATE@ 1 0
  TEMPO @TEMPO@ 4 4
  LOOP @LOOP@
  SELECTION @SELECTION@
  PANLAW 1
  PANMODE 3
  MASTER_NCH 2 2
  MASTER_VOLUME 1 0 -1 -1 1
  RENDER_FILE "out"
  RENDER_PATTERN "$track"
  RENDER_FMT 0 2 @RATE@
  RENDER_1X 0
  RENDER_RANGE 0 0 @SECONDS@ 0 0
  RENDER_RESAMPLE 3 0 1
  RENDER_ADDTOPROJ 0
  RENDER_STEMS @STEMS@
  RENDER_DITHER 0
  <RENDER_CFG
    ZXZhdyAAAA==
  >
@TRACKS@>
